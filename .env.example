# Postgres connection string (Neon recommended). Leave unset for in-memory store (local/dev/tests).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the httpOnly session cookie. Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-string

# Bearer token for GET /api/cron/cleanup (Vercel Cron sends Authorization: Bearer $CRON_SECRET).
CRON_SECRET=replace-with-a-long-random-string
